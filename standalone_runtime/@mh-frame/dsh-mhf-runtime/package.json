{
  "name": "@mh-frame/dsh-mhf-runtime",
  "version": "0.5.14",
  "private": true,
  "description": "Online MH Frame runtime for DeepSeek Harness",
  "mhfProtectionMarker": "MH-PROTECTED",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test:prompts": "node --test tests/custom-prompt.mjs tests/provider-request.mjs tests/authorization.mjs tests/protection.mjs test/non-json-response.test.mjs",
    "test:prompt-ui": "node tests/custom-prompt-ui.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./settings": "./lib/settings.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-api-remotes": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-sidebar": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
	"@deepseek-ai/dsh-session-persistence": "*",
	"@deepseek-ai/dsh-workspace": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/provider-request.js",
    "lib/client.js",
    "lib/settings.js",
	"lib/online.js",
	"lib/protection.js",
	"lib/mhf-icon.png",
    "lib/windows-compat.js"
  ],
  "license": "UNLICENSED"
}
